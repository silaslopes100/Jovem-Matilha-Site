{
  "name": "jovem-matilha-site",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build:css": "npm run build:css:site && npm run build:css:home",
    "build:css:site": "tailwindcss -c tailwind.config.js -i assets/tailwind.input.css -o assets/site.css --minify",
    "build:css:home": "tailwindcss -c tailwind.home.config.js -i assets/tailwind.input.css -o assets/home.css --minify"
  },
  "devDependencies": {
    "@tailwindcss/container-queries": "0.1.1",
    "@tailwindcss/forms": "0.5.10",
    "tailwindcss": "3.4.17"
  }
}
